# Settings for docker-compose.prod.yml. On the server copy this file to
# .env.production and replace every change-me and <...> with your own values.
# .env.production is ignored by git and by Docker: never commit it.
# Do not use a $ character in any value (Docker Compose reads it as a variable).

# Django
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=<host name of the server>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<host name of the server>
# Behind Caddy over HTTPS: secure cookies and the forwarded-protocol header
DJANGO_HTTPS=True

# Caddy: the public host name (HTTPS certificate is requested for it)
SITE_ADDRESS=<host name of the server>

# PostgreSQL (the web container reaches it as host "db")
POSTGRES_DB=rongraam
POSTGRES_USER=rongraam
POSTGRES_PASSWORD=change-me

# gunicorn workers: 2 fits a 1 GiB server, 3 fits 4 GiB
WEB_CONCURRENCY=2

# Email: "console" prints emails in the container log until an SMTP service is chosen
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Stripe (test mode keys only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Demo data: password of the demo accounts, and whether to load them at start
SEED_DEMO_PASSWORD=change-me
SEED_ON_START=false
